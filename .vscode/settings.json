{
    // リポジトリの直下には Cargo.toml がないため、rust-analyzer に読ませるファームウェアと、単独で組み立てるクレートを指定する。
    // ほかの crates/ のクレートは、ファームウェアの依存として一緒に読まれる。
    // managed_switch の logic は、PC 上の単体テストも検査させるため、単独でも指定する。
    "rust-analyzer.linkedProjects": [
        "projects/managed_switch/firmware/Cargo.toml",
        "projects/managed_switch/logic/Cargo.toml",
        "projects/riscv_rust/firmware/Cargo.toml",
        "third_party/neorv32_probe_rs/bootrom/Cargo.toml",
        "flash_algorithms/mt25q/Cargo.toml"
    ],
    // rust-analyzer の検査と cargo run が同じビルドのフォルダを取り合わないよう、検査は別のフォルダに出す。
    "rust-analyzer.cargo.targetDir": true,
    // 保存したファイルは、コミットの前と同じフォーマッタで整形する。
    // Rust は rust-analyzer が同じ rustfmt の既定の設定で整形するため、そちらに任せる。
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    // ほかの種類は、フォーマッタと版を .claude/settings.json の hook とそろえる。
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": "\\.py$",
                "cmd": "uvx ruff@0.16.8 format \"${file}\""
            },
            {
                "match": "\\.vhd$",
                "cmd": "uvx --from vsg==3.35.0 vsg -c \"${workspaceFolder}/vsg.yaml\" --fix -f \"${file}\""
            },
            {
                "match": "\\.(md|json|ya?ml)$",
                "cmd": "npx --yes prettier@3.9.8 --write \"${file}\""
            }
        ]
    }
}
