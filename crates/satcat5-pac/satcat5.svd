<?xml version="1.0" encoding="utf-8"?>
<!--
  SatCat5 の ConfigBus のデバイスのうち、このリポジトリのファームウェアが使うもののレジスタ。
  各デバイスのコメントに書かれたレジスタの一覧を、そのまま書き写した。
  ConfigBus のレジスタは 32 ビットで、レジスタ番号の 4 倍がアドレスになる。
  デバイスのアドレスは設計ごとに違うため、ここでは 0 とし、各プロジェクトが与える。
-->
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <name>SATCAT5</name>
  <version>2.9.0</version>
  <description>SatCat5 ConfigBus devices</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>

    <!-- src/vhdl/common/switch_types.vhd の ConfigBus のレジスタの一覧 -->
    <peripheral>
      <name>SWITCH_CORE</name>
      <description>Ethernet switch core</description>
      <baseAddress>0x00000000</baseAddress>
      <addressBlock><offset>0</offset><size>0x1000</size><usage>registers</usage></addressBlock>
      <registers>
        <register><name>PORT_COUNT</name><description>Number of ports</description><addressOffset>0x00</addressOffset><access>read-only</access></register>
        <register><name>DATA_WIDTH</name><description>Datapath width in bits</description><addressOffset>0x04</addressOffset><access>read-only</access></register>
        <register><name>CORE_CLOCK</name><description>Core clock frequency in Hz</description><addressOffset>0x08</addressOffset><access>read-only</access></register>
        <register><name>TABLE_SIZE</name><description>MAC-address table size</description><addressOffset>0x0C</addressOffset><access>read-only</access></register>
        <register><name>PROMISCUOUS</name><description>Promiscuous port mask, LSB is port 0</description><addressOffset>0x10</addressOffset><access>read-write</access><writeConstraint><range><minimum>0</minimum><maximum>4294967295</maximum></range></writeConstraint></register>
        <register>
          <name>FRAME_SIZE</name><description>Frame size limits in bytes</description><addressOffset>0x1C</addressOffset><access>read-only</access>
          <fields>
            <field><name>MIN</name><bitRange>[15:0]</bitRange></field>
            <field><name>MAX</name><bitRange>[31:16]</bitRange></field>
          </fields>
        </register>
        <register><name>QUERY_MAC_LSB</name><description>MAC-table access: 32 LSBs of the MAC address</description><addressOffset>0x2C</addressOffset><access>read-write</access><writeConstraint><range><minimum>0</minimum><maximum>4294967295</maximum></range></writeConstraint></register>
        <register>
          <name>QUERY_MAC_MSB</name><description>MAC-table access: 16 MSBs of the MAC address</description><addressOffset>0x30</addressOffset><access>read-write</access>
          <fields>
            <field><name>MAC</name><bitRange>[15:0]</bitRange><writeConstraint><range><minimum>0</minimum><maximum>65535</maximum></range></writeConstraint></field>
          </fields>
        </register>
        <register>
          <name>QUERY_CTRL</name><description>MAC-table access: opcode and argument (src/vhdl/common/mac_query.vhd)</description><addressOffset>0x34</addressOffset><access>read-write</access>
          <fields>
            <field><name>ARG</name><description>Table index or port index; after a read, the port index</description><bitRange>[15:0]</bitRange><writeConstraint><range><minimum>0</minimum><maximum>65535</maximum></range></writeConstraint></field>
            <field>
              <name>OPCODE</name><description>Reads back the opcode while busy, zero when done</description><bitRange>[31:24]</bitRange>
              <enumeratedValues>
                <enumeratedValue><name>IDLE</name><value>0</value></enumeratedValue>
                <enumeratedValue><name>READ</name><value>1</value></enumeratedValue>
                <enumeratedValue><name>WRITE</name><value>2</value></enumeratedValue>
                <enumeratedValue><name>CLEAR</name><value>3</value></enumeratedValue>
                <enumeratedValue><name>LEARN</name><value>4</value></enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <!-- src/vhdl/common/port_mailmap.vhd -->
    <peripheral>
      <name>PORT_MAILMAP</name>
      <description>Memory-mapped switch port for the CPU</description>
      <baseAddress>0x00000000</baseAddress>
      <addressBlock><offset>0</offset><size>0x1000</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <dim>400</dim><dimIncrement>4</dimIncrement>
          <name>RX_DATA[%s]</name><description>Received frame contents</description><addressOffset>0x000</addressOffset><access>read-only</access>
        </register>
        <register><name>RX_CTRL</name><description>Read: received frame length, 0 when empty. Write: discard the frame and read the next</description><addressOffset>0x7FC</addressOffset><access>read-write</access><writeConstraint><range><minimum>0</minimum><maximum>4294967295</maximum></range></writeConstraint></register>
        <register>
          <dim>400</dim><dimIncrement>4</dimIncrement>
          <name>TX_DATA[%s]</name><description>Transmit frame buffer</description><addressOffset>0x800</addressOffset><access>read-write</access><writeConstraint><range><minimum>0</minimum><maximum>4294967295</maximum></range></writeConstraint>
        </register>
        <register><name>TX_CTRL</name><description>Write: frame length to send. Read: 1 while busy</description><addressOffset>0xFFC</addressOffset><access>read-write</access><writeConstraint><range><minimum>0</minimum><maximum>4294967295</maximum></range></writeConstraint></register>
      </registers>
    </peripheral>

    <!-- src/vhdl/common/cfgbus_port_stats.vhd -->
    <peripheral>
      <name>PORT_STATS</name>
      <description>Per-port traffic statistics</description>
      <baseAddress>0x00000000</baseAddress>
      <addressBlock><offset>0</offset><size>0x1000</size><usage>registers</usage></addressBlock>
      <registers>
        <cluster>
          <dim>64</dim><dimIncrement>0x40</dimIncrement>
          <name>PORT[%s]</name><description>Sixteen registers per port</description><addressOffset>0x00</addressOffset>
          <register><name>BCAST_BYTES</name><description>Broadcast bytes received. A write to any register refreshes all counters</description><addressOffset>0x00</addressOffset><access>read-write</access><writeConstraint><range><minimum>0</minimum><maximum>4294967295</maximum></range></writeConstraint></register>
          <register><name>BCAST_FRAMES</name><description>Broadcast frames received</description><addressOffset>0x04</addressOffset><access>read-only</access></register>
          <register><name>RCVD_BYTES</name><description>Bytes received from the device</description><addressOffset>0x08</addressOffset><access>read-only</access></register>
          <register><name>RCVD_FRAMES</name><description>Frames received from the device</description><addressOffset>0x0C</addressOffset><access>read-only</access></register>
          <register><name>SENT_BYTES</name><description>Bytes sent to the device</description><addressOffset>0x10</addressOffset><access>read-only</access></register>
          <register><name>SENT_FRAMES</name><description>Frames sent to the device</description><addressOffset>0x14</addressOffset><access>read-only</access></register>
          <register>
            <name>ERRORS</name><description>Error counts since the previous refresh</description><addressOffset>0x18</addressOffset><access>read-only</access>
            <fields>
              <field><name>PKT</name><description>Packet errors</description><bitRange>[7:0]</bitRange></field>
              <field><name>OVR_RX</name><description>Rx-FIFO overflows</description><bitRange>[15:8]</bitRange></field>
              <field><name>OVR_TX</name><description>Tx-FIFO overflows</description><bitRange>[23:16]</bitRange></field>
              <field><name>MII</name><description>MAC and PHY errors</description><bitRange>[31:24]</bitRange></field>
            </fields>
          </register>
          <register>
            <name>LINK</name><description>Link status, read without a refresh</description><addressOffset>0x20</addressOffset><access>read-only</access>
            <fields>
              <field><name>STATUS</name><description>Port status word</description><bitRange>[7:0]</bitRange></field>
              <field><name>SPEED</name><description>Link speed in Mbps</description><bitRange>[31:16]</bitRange></field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>

    <!-- src/vhdl/common/cfgbus_mdio.vhd -->
    <peripheral>
      <name>MDIO</name>
      <description>MDIO controller with a command FIFO</description>
      <baseAddress>0x00000000</baseAddress>
      <addressBlock><offset>0</offset><size>0x1000</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>MDIO</name><description>Write: queue an operation. Read: FIFO status and read data</description><addressOffset>0x00</addressOffset><access>read-write</access>
          <fields>
            <field><name>DATA</name><description>Write data, or read data when VALID</description><bitRange>[15:0]</bitRange><writeConstraint><range><minimum>0</minimum><maximum>65535</maximum></range></writeConstraint></field>
            <field><name>REG</name><description>Register address</description><bitRange>[20:16]</bitRange><access>write-only</access><writeConstraint><range><minimum>0</minimum><maximum>31</maximum></range></writeConstraint></field>
            <field><name>PHY</name><description>PHY address</description><bitRange>[25:21]</bitRange><access>write-only</access><writeConstraint><range><minimum>0</minimum><maximum>31</maximum></range></writeConstraint></field>
            <field>
              <name>OP</name><bitRange>[27:26]</bitRange><access>write-only</access>
              <enumeratedValues>
                <enumeratedValue><name>WRITE</name><value>1</value></enumeratedValue>
                <enumeratedValue><name>READ</name><value>2</value></enumeratedValue>
              </enumeratedValues>
            </field>
            <field><name>VALID</name><description>Read data is valid</description><bitRange>[30:30]</bitRange><access>read-only</access></field>
            <field><name>FULL</name><description>Command FIFO is full</description><bitRange>[31:31]</bitRange><access>read-only</access></field>
          </fields>
        </register>
      </registers>
    </peripheral>

  </peripherals>
</device>
