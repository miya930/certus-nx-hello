ldc_set_location -site {L1} [get_ports rgmii_txclk]
ldc_set_location -site {J5} [get_ports rgmii_txctrl]
ldc_set_location -site {H6} [get_ports {rgmii_txd[0]}]
ldc_set_location -site {H5} [get_ports {rgmii_txd[1]}]
ldc_set_location -site {H4} [get_ports {rgmii_txd[2]}]
ldc_set_location -site {H3} [get_ports {rgmii_txd[3]}]

ldc_set_location -site {J1} [get_ports rgmii_rxclk]
ldc_set_location -site {J2} [get_ports rgmii_rxctrl]
ldc_set_location -site {K2} [get_ports {rgmii_rxd[0]}]
ldc_set_location -site {K4} [get_ports {rgmii_rxd[1]}]
ldc_set_location -site {K3} [get_ports {rgmii_rxd[2]}]
ldc_set_location -site {K6} [get_ports {rgmii_rxd[3]}]

ldc_set_location -site {L2} [get_ports rgmii_mdio_clk]
ldc_set_location -site {M1} [get_ports rgmii_mdio_data]
ldc_set_location -site {M2} [get_ports rgmii_rst_n]

ldc_set_location -site {H13} [get_ports clk_customer2]
ldc_set_location -site {F16} [get_ports system_25m_clk]
ldc_set_location -site {J16} [get_ports pushbutton3]

ldc_set_location -site {F10} [get_ports txd_uart]
ldc_set_location -site {E13} [get_ports rxd_uart]

ldc_set_location -site {B3} [get_ports {led[0]}]
ldc_set_location -site {A2} [get_ports {led[1]}]
ldc_set_location -site {H16} [get_ports {led[2]}]
ldc_set_location -site {B2} [get_ports {led[3]}]
ldc_set_location -site {H15} [get_ports {led[4]}]
ldc_set_location -site {H14} [get_ports {led[5]}]
ldc_set_location -site {H12} [get_ports {led[6]}]
ldc_set_location -site {J15} [get_ports {led[7]}]

# Bank 6 の電源は J48 の既定で 3.3 V になる。
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports rgmii_txclk]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports rgmii_txctrl]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {rgmii_txd[0]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {rgmii_txd[1]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {rgmii_txd[2]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {rgmii_txd[3]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports rgmii_rxclk]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports rgmii_rxctrl]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {rgmii_rxd[0]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {rgmii_rxd[1]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {rgmii_rxd[2]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {rgmii_rxd[3]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports rgmii_mdio_clk]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports rgmii_mdio_data]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports rgmii_rst_n]

ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports clk_customer2]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports system_25m_clk]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=UP} [get_ports pushbutton3]

ldc_set_port -iobuf {IO_TYPE=LVCMOS33 PULLMODE=UP} [get_ports txd_uart]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports rxd_uart]

ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led[0]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led[1]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led[2]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led[3]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led[4]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led[5]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led[6]}]
ldc_set_port -iobuf {IO_TYPE=LVCMOS33} [get_ports {led[7]}]
