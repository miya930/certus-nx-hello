# 回路規模を確認するためのピン割り当てで、評価ボードの配線とは対応しない。
# 8 ポートぶんを割り当てており、PORT_COUNT が小さいときに存在しないポートへの指定は nextpnr-nexus が無視する。

ldc_set_location -site {F6} [get_ports rmii_ref_clk]
ldc_set_location -site {F16} [get_ports system_25m_clk]
ldc_set_location -site {D6} [get_ports reset_p]

ldc_set_location -site {E6} [get_ports {rmii_txd[0]}]
